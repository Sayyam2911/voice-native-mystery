# Server-only secrets. Never paste these into browser code or commit .env.
MONGODB_URI=
MONGODB_DB=voice_native_mystery
ASSEMBLYAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Generate a long random value and keep it identical locally and on Vercel.
APP_SECRET=
# Public deployed origin (or your HTTPS tunnel for a local voice test).
PUBLIC_BASE_URL=
MAX_DAILY_SESSIONS=20
MAX_ACTIVE_VOICE_SESSIONS=5
MAX_TURNS_PER_SESSION=100
# Use explicit fixture mode for offline development; never silently fake live AI.
ALLOW_OFFLINE_DEMO=false
