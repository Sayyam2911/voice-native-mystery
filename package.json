{
  "name": "voice-native-mystery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "format": "prettier --write src server api cases tests scripts *.json *.js",
    "format:check": "prettier --check src server api cases tests scripts *.json *.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "check:services": "node --env-file-if-exists=.env scripts/check-services.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.9",
    "vite": "^7.1.7"
  }
}
